node_modules/
.env
.cache/
.skyhook/
dist/
coverage/
*.log

# Test fixtures: every `node --test` file builds its own `.tmp-*` project under the repo root and
# removes it in an `after()` hook. A red run or a Ctrl+C can still leave one, and it is never
# something to commit (#22).
.tmp-*

# User config — the example lives in config/, but a live config at the root is gitignored.
skyhook.config.json
config/skyhook.config.json

# Local SQLite state / logs
*.db
*.db-wal
*.db-shm

# Desktop shell build output and the fetched sidecar binary — never tracked.
# `src-tauri/target/` appears on the first `tauri dev`; the installer lands in
# dist/desktop/ and the pinned node.exe is fetched, not committed. `src-tauri/gen/`
# is the ACL schema set the CLI regenerates on every build.
src-tauri/target/
src-tauri/gen/
dist/desktop/
src-tauri/binaries/*.exe
# The stamp `fetch-sidecar.mjs` writes beside it: which pin placed that runtime. A build
# artifact like the binary, and the reason a re-pin refetches instead of shipping the old one.
src-tauri/binaries/*.pin
