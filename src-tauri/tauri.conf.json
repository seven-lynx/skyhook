{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyhook",
  "version": "0.4.2",
  "identifier": "com.sevenlynx.skyhook",
  "build": {
    "frontendDist": "../src/gui",
    "beforeBuildCommand": "node scripts/fetch-sidecar.mjs"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/skyhook-sidecar"],
    "resources": {
      "../dist/desktop/app": "app"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
