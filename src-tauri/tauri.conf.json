{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyhook",
  "version": "0.4.3",
  "identifier": "com.sevenlynx.skyhook",
  "build": {
    "frontendDist": "../src/gui",
    "beforeBuildCommand": "node scripts/fetch-sidecar.mjs"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/skyhook-sidecar"],
    "resources": {
      "../dist/desktop/app": "app"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNTM0RTAwNkExQzg1QzAKUldUQWhSeHFBRTVUNFVoL1BUSHhrcFRlcTVWbjhLVCtabVI4OXFZU0JkZk1mSWIzSXFuWmVZUFMK",
      "endpoints": [
        "https://github.com/seven-lynx/skyhook/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
