# Credentials and overrides only. Copy to `.env` in the project root; that file is
# gitignored and never ships. Every key here is optional — an empty file is the
# product, since `src/config.js` DEFAULTS already is.
#
# Precedence, in order: `.skyhook/settings.json` (runtime toggles the API/GUI
# write) → `skyhook.config.json` → these overrides → the defaults.
#
# Keep every value empty in this file. A secret committed here is the whole
# point of the file lost.

# ── Storage (optional; `storage.provider: "stage"` needs none of these) ────────
# Supabase: the URL and the SERVICE ROLE key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres: one connection string. The first non-empty one wins.
POSTGRES_URL=
DATABASE_URL=

# ── The remote token ─────────────────────────────────────────────────────────
# The shared secret behind every mutating route (`POST /api/*`) and the header a
# node presents to a peer. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SKYHOOK_REMOTE_TOKEN=

# ── FlareSolverr (optional Cloudflare bypass) ────────────────────────────────
# `1` turns the bypass on; anything else leaves it off, and a 403 stays a 403.
FLARESOLVERR_ENABLED=
FLARESOLVERR_URL=
FLARESOLVERR_EXE=
FLARESOLVERR_PORT=

# ── Internal knobs (set by tests and the desktop sidecar; usually not yours) ──
# SKYHOOK_SKIP_HEADLESS=1        skip the headless-browser tier (the systemd default)
# SKYHOOK_STALL_TIMEOUT_MS=       how long a run may stall before it is killed
# SKYHOOK_MAX_DURATION_MS=        a run's hard ceiling
# SKYHOOK_FLARESOLVERR_MANAGED=1  the managed instance was started by this process
